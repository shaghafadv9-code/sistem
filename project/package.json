{
  "name": "smart-secretary",
  "productName": "Smart Secretary",
  "version": "1.0.0",
  "description": "نظام سكرتير ذكي احترافي لإدارة الأعمال — Smart Secretary",
  "main": "electron/main.js",
  "author": "Smart Secretary",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "server": "node server/index.js",
    "client": "vite --config client/vite.config.js",
    "dev": "concurrently -n API,WEB -c blue,green \"npm run server\" \"npm run client\"",
    "build:client": "vite build --config client/vite.config.js",
    "test": "node scripts/test.js",
    "electron": "electron .",
    "dist": "npm run build:client && electron-builder --win nsis --config builder.config.js",
    "pack": "npm run build:client && electron-builder --win --dir --config builder.config.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7",
    "sql.js": "^1.14.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
